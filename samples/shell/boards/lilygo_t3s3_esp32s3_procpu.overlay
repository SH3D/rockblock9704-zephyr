/* LilyGO T3-S3: the modem on uart0, GPIO43 (TX) and GPIO44 (RX) on the
 * header. The console is on the S3's native USB, so uart0 is free.
 *
 * The ESP32-S3's ROM prints on GPIO43 at every reset, before Zephyr runs, so
 * the modem sees some junk; rbBegin() drains it and resynchronises. If it
 * ever matters, hold I_EN low until the board is up (iridium-enable-gpios). */
&uart0 {
	current-speed = <230400>;
	status = "okay";

	rockblock {
		compatible = "rock7,rockblock-9704";
	};
};
