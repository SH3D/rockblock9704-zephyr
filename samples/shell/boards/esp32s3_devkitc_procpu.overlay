/* ESP32-S3-DevKitC: the modem on uart1, GPIO17 (TX) and GPIO18 (RX), with
 * its control lines on GPIO6 (P_EN), GPIO4 (I_EN) and GPIO5 (I_BTD). */
&pinctrl {
	uart1_rb9704: uart1_rb9704 {
		group1 {
			pinmux = <UART1_TX_GPIO17>;
			output-high;
		};
		group2 {
			pinmux = <UART1_RX_GPIO18>;
			bias-pull-up;
		};
	};
};

&uart1 {
	pinctrl-0 = <&uart1_rb9704>;
	pinctrl-names = "default";
	current-speed = <230400>;
	status = "okay";

	rb9704: rockblock {
		compatible = "rock7,rockblock-9704";
		power-gpios = <&gpio0 6 GPIO_ACTIVE_LOW>;		/* P_EN, active low */
		iridium-enable-gpios = <&gpio0 4 GPIO_ACTIVE_HIGH>;	/* I_EN */
		booted-gpios = <&gpio0 5 GPIO_ACTIVE_HIGH>;		/* I_BTD */
	};
};
