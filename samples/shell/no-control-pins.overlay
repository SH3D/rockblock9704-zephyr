/* SPDX-License-Identifier: MIT
 * Copyright (c) 2026 Scott Penrose <scottp@dd.com.au>
 *
 * The modem on TX and RX alone: P_EN, I_EN and I_BTD taken out of the
 * board overlay's node, for a modem wired with four wires. The module
 * then takes it to be powered, as the RockBLOCK is with the pins open.
 *
 *   west build -b stamp_c3 samples/shell -- \
 *     -DEXTRA_DTC_OVERLAY_FILE=no-control-pins.overlay
 */
&rb9704 {
	/delete-property/ power-gpios;
	/delete-property/ iridium-enable-gpios;
	/delete-property/ booted-gpios;
};
